{
  "manifest_version": 3,
  "name": "大数据平台数据导出工具",
  "version": "1.4.0",
  "description": "为大数据平台即席查询模块提供一键导出全部数据为Excel的功能",
  "permissions": [
    "activeTab",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "*://nqi.gmcc.net/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "大数据平台导出工具",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://nqi.gmcc.net/*"],
      "js": ["content.js"],
      "css": ["styles/export-button.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*"],
      "matches": ["*://nqi.gmcc.net/*"]
    }
  ]
}
